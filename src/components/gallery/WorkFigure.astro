---
import { Image, Picture } from 'astro:assets';
import type { Work, Stylist } from '../../lib/services';
import { WORK_CATEGORY_LABELS } from '../../lib/services';
import { firstName } from '../../lib/format';

interface Props {
  work: Work;
  stylist?: Stylist;
  sizes: string;
  class?: string;
  index?: number;
}

const { work, stylist, sizes, class: className, index = 0 } = Astro.props;
const w = work.data;
---

<figure class:list={['reveal group', className]} style={`--i:${index % 4}`}>
  <div class="frame relative rounded-photo">
    <Picture
      src={w.image}
      alt={w.alt}
      widths={[320, 480, 640, 900]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading="lazy"
      class="block h-auto w-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
     pictureAttributes={{ class: "contents" }}/>
  </div>
  <figcaption class="mt-3 flex flex-col gap-1 text-[0.875rem] leading-snug md:flex-row md:items-baseline md:justify-between md:gap-3">
    <span class="text-ink">{w.title}</span>
    <span class="label-caps text-[0.75rem] text-muted md:shrink-0">
      {WORK_CATEGORY_LABELS[w.category]}{stylist && ` · ${firstName(stylist.data.name)}`}
    </span>
  </figcaption>
</figure>
