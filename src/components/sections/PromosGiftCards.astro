---
import { site } from '../../config/site';
import { whatsappHref } from '../../lib/booking';
import { formatPrice } from '../../lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const copy = site.copy.promos;
const { promos, giftCards, deposit, cancellation, paymentDiscount } = site.commercial;
const active = promos.filter((p) => p.active);
const policy = [
  { label: copy.depositLabel, text: deposit.description },
  { label: copy.cancellationLabel, text: cancellation.summary },
  { label: copy.paymentLabel, text: paymentDiscount.description },
];
---

<section id="promos" class="section-y bg-surface" aria-labelledby="promos-title">
  <div class="container-site">
    <SectionHeading id="promos-title" title={copy.title} lead={copy.lead} />

    <div class="mt-12 grid gap-6 md:mt-16 lg:grid-cols-12 lg:gap-8">
      {
        active.map((promo) => (
          <article class="reveal rounded-photo bg-paper p-6 md:p-10 lg:col-span-7">
            <h3 class="text-h2 max-w-[16ch]">{promo.title}</h3>
            <p class="mt-4 max-w-[48ch] text-muted">{promo.description}</p>
            <h4 class="label-caps mt-8 font-sans text-brand-strong">{copy.conditionsLabel}</h4>
            <ul class="mt-3 divide-y divide-line border-y border-line">
              {promo.conditions.map((c) => (
                <li class="py-3 text-small">{c}</li>
              ))}
            </ul>
          </article>
        ))
      }

      <article class="reveal flex flex-col rounded-photo border border-line p-6 md:p-10 lg:col-span-5" style="--i:1">
        <Icon name="gift" size={28} class="text-brand" />
        <h3 class="mt-6 text-h2">{giftCards.title}</h3>
        <p class="mt-4 text-muted">{giftCards.description}</p>
        <p class="label-caps mt-8 text-brand-strong">{copy.amountsLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            giftCards.amounts.map((amount) => (
              <li class="nums rounded-pill border border-line bg-bg px-3.5 py-1.5 text-small font-semibold">
                {formatPrice(amount)}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-small text-muted">{giftCards.notice}</p>
        <div class="mt-auto pt-8">
          <Button href={whatsappHref(site.booking.whatsapp.giftCard)} variant="secondary" icon="message" iconStart>
            {copy.giftCardCta}
          </Button>
        </div>
      </article>
    </div>

    <div class="reveal mt-16 border-t border-line pt-10 md:mt-20">
      <div class="flex flex-col gap-4 md:flex-row md:items-baseline md:justify-between">
        <h3 class="text-h3">{copy.policyTitle}</h3>
        <a
          href="/politica-de-turnos"
          class="label-caps inline-flex min-h-11 items-center gap-2 text-accent no-underline"
        >
          <span class="link-line">{copy.policyLink}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <dl class="mt-8 grid gap-8 md:grid-cols-3 md:gap-0">
        {
          policy.map((item, i) => (
            <div class:list={['md:px-8 md:first:pl-0', i > 0 && 'md:border-l md:border-line']}>
              <dt class="label-caps text-brand-strong">{item.label}</dt>
              <dd class="mt-3 max-w-[36ch] text-small">{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
