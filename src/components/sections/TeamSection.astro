---
import { site } from '../../config/site';
import type { Stylist } from '../../lib/services';
import SectionHeading from '../ui/SectionHeading.astro';
import TeamCard from '../team/TeamCard.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  team: Stylist[];
}

const { team } = Astro.props;
const copy = site.copy.team;
---

<section class="section-y bg-surface pb-36 md:pb-48 lg:pb-56" aria-labelledby="equipo-title">
  <div class="container-site">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="equipo-title" title={copy.title} lead={copy.lead} />
      <a href="/equipo" class="label-caps inline-flex min-h-11 items-center gap-2 self-start text-accent no-underline md:self-auto">
        <span class="link-line">{site.pages.team.title}</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 md:mt-16 lg:grid-cols-4 lg:gap-x-8">
      {team.map((stylist, i) => <TeamCard stylist={stylist} index={i} />)}
    </div>
  </div>
</section>
