---
import { site } from '../../config/site';

const words = site.copy.marquee;
---

<div class="marquee overflow-hidden border-y border-line bg-bg py-5 md:py-7">
  <div class="marquee-track">
    {
      [0, 1].map((copy) => (
        <ul
          class:list={['flex shrink-0 items-center', copy === 1 && 'marquee-dup']}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {words.map((word) => (
            <li class="font-display-soft flex items-center text-[clamp(1.75rem,1.2rem+2.4vw,3.25rem)] leading-none tracking-[-0.02em] whitespace-nowrap text-ink">
              <span class="px-6 md:px-10">{word}</span>
              <span aria-hidden="true" class="size-1.5 rounded-pill bg-brand" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
