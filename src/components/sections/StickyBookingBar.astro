---
import { site } from '../../config/site';
import { bookingHref, whatsappHref } from '../../lib/booking';
import { externalAttrs } from '../../lib/links';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<div
  class="fixed inset-x-0 bottom-0 z-30 flex gap-3 border-t border-line bg-paper px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:hidden"
>
  <Button href={bookingHref()} class="flex-1">{site.booking.ctaLabel}</Button>
  <a
    href={whatsappHref()}
    {...externalAttrs(whatsappHref())}
    aria-label={`${site.ui.whatsappIconLabel} ${site.ui.newTabHint}`}
    class="inline-flex size-12 shrink-0 items-center justify-center rounded-button border border-accent text-accent transition-colors hover:bg-accent hover:text-on-accent"
  >
    <Icon name="message" size={22} />
  </a>
</div>
