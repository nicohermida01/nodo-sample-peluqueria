---
import { site } from '../../config/site';
import { externalAttrs } from '../../lib/links';
import Icon from './Icon.astro';

const copy = site.copy.location;
const { address } = site;
---

<div class="map-facade frame relative aspect-4/3 rounded-photo border border-line md:aspect-auto md:h-full md:min-h-[26rem]" data-map data-src={address.mapEmbedUrl} data-title={copy.mapFrameTitle}>
  <svg class="map-grid absolute inset-0 size-full text-line" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 400 300" fill="none" stroke="currentColor">
    <g stroke-width="1">
      <path d="M-20 40 L420 10" /><path d="M-20 110 L420 80" /><path d="M-20 180 L420 150" /><path d="M-20 250 L420 220" />
      <path d="M60 -20 L90 320" /><path d="M160 -20 L190 320" /><path d="M260 -20 L290 320" /><path d="M350 -20 L380 320" />
    </g>
    <path d="M-20 300 C 120 200, 220 160, 420 60" stroke-width="6" opacity="0.6" />
  </svg>
  <div class="relative flex h-full flex-col items-center justify-center gap-5 p-6 text-center" data-map-placeholder>
    <span class="inline-flex size-14 items-center justify-center rounded-pill bg-accent text-on-accent">
      <Icon name="map-pin" size={26} />
    </span>
    <p class="font-display-soft text-h3">{address.street}<span class="block text-small font-sans text-muted">{address.neighborhood}, {address.region}</span></p>
    <button
      type="button"
      class="label-caps inline-flex min-h-12 items-center gap-2 rounded-button border border-accent bg-accent px-6 text-on-accent transition-colors hover:bg-transparent hover:text-accent"
      data-map-load
    >
      {copy.mapButton}
    </button>
    <p class="max-w-[34ch] text-[0.8125rem] text-muted">{copy.mapNotice}</p>
  </div>
</div>
<a
  href={address.mapsUrl}
  {...externalAttrs(address.mapsUrl)}
  class="label-caps mt-4 inline-flex min-h-11 items-center gap-2 text-accent no-underline"
>
  <span class="link-line">{copy.mapsLink}</span>
  <Icon name="arrow-up-right" size={16} />
  <span class="sr-only">{site.ui.newTabHint}</span>
</a>

<script>
  let controller: AbortController | undefined;

  function setupMap() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
      root.querySelector('[data-map-load]')?.addEventListener(
        'click',
        () => {
          const iframe = document.createElement('iframe');
          iframe.src = root.dataset.src ?? '';
          iframe.title = root.dataset.title ?? '';
          iframe.loading = 'lazy';
          iframe.referrerPolicy = 'no-referrer-when-downgrade';
          iframe.allowFullscreen = true;
          iframe.className = 'absolute inset-0 size-full border-0';
          root.querySelector('[data-map-placeholder]')?.remove();
          root.querySelector('.map-grid')?.remove();
          root.append(iframe);
          iframe.focus();
        },
        { signal, once: true },
      );
    });
  }

  document.addEventListener('astro:page-load', setupMap);
</script>
