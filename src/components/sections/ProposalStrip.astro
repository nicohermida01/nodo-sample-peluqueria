---
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';

const { label, items } = site.copy.proposal;
---

<section aria-label={label} class="bg-bg">
  <ul class="container-site grid grid-cols-2 py-12 md:py-16 lg:grid-cols-4">
    {
      items.map((item, i) => (
        <li
          class:list={[
            'reveal border-line px-4 py-6 first:pl-0 md:px-8 lg:py-2',
            i % 2 === 1 && 'border-l',
            i >= 2 && 'border-t lg:border-t-0',
            i === 2 && 'pl-0 lg:border-l lg:pl-8',
          ]}
          style={`--i:${i}`}
        >
          <Icon name={item.icon} size={24} class="mb-4 text-brand" />
          <p class="font-display-soft text-h3 text-ink">{item.title}</p>
          <p class="mt-2 max-w-[30ch] text-small text-muted">{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>
