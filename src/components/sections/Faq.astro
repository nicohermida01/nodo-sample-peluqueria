---
import { site } from '../../config/site';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
---

<section class="section-y border-t border-line bg-paper" aria-labelledby="faq-title">
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <SectionHeading id="faq-title" title={site.copy.faq.title} class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]" />
    </div>
    <div class="border-t border-line lg:col-span-8">
      {
        site.faq.map((item, i) => (
          <details name="faq" class="faq group border-b border-line" open={i === 0}>
            <summary class="flex min-h-16 cursor-pointer items-center justify-between gap-6 py-5 text-ink">
              <span class="font-display-soft text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] leading-snug">
                {item.question}
              </span>
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-pill border border-line text-accent transition-colors group-open:border-accent group-open:bg-accent group-open:text-on-accent">
                <Icon name="plus" size={18} class="group-open:hidden" />
                <Icon name="minus" size={18} class="hidden group-open:block" />
              </span>
            </summary>
            <div class="faq-body pb-6">
              <p class="max-w-[60ch] text-muted">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .faq[open] .faq-body {
      animation: faq-in 380ms var(--ease-out-soft);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
