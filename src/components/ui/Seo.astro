---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.seo.description,
  image = site.copy.hero.media.desktop.src,
  imageAlt = site.copy.hero.media.desktop.alt,
  noindex = false,
} = Astro.props;

const pageTitle = title ? site.seo.titleTemplate.replace('%s', title) : site.seo.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site ?? site.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={site.seo.keywords.join(', ')} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content={site.seo.themeColor} />

<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.brand.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width)} />
<meta property="og:image:height" content={String(og.attributes.height)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
